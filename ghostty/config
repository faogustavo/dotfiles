font-size=17
font-family=MesloLGS NF
font-feature=+liga

window-theme=system
macos-titlebar-style=tabs
macos-option-as-alt = right

quick-terminal-position=bottom
quick-terminal-screen=macos-menu-bar
keybind = global:super+alt+ctrl+shift+1=toggle_quick_terminal

keybind = command+k=text:\x0c
keybind = ctrl+r=reload_config